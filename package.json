{
  "name": "post-season",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm test && npm run build && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm test && npm run build",
    "verify:full": "npm test && npm run build && npm run test:e2e && npm run verify:pages",
    "verify:pages": "node scripts/verify-pages.mjs",
    "docs:changed-check": "node scripts/docs-change-check.mjs",
    "adr:check": "node scripts/adr-check.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "size:check": "node scripts/size-budget-check.mjs",
    "deadcode": "knip --no-exit-code",
    "quality": "npm run format:check && npm run lint && npm run architecture:check && npm run size:check && npm run adr:check && npm run docs:changed-check && npm run verify",
    "quality:full": "npm run quality && npm run test:e2e && npm run verify:pages && npm run deadcode",
    "search:assist": "rg --line-number --hidden --glob \"!node_modules\" --glob \"!dist\" --glob \"!coverage\" --glob \"!supabase/.temp\"",
    "commitlint:last": "commitlint --last --verbose",
    "commitlint:range": "commitlint --verbose",
    "preview": "vite preview",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:push": "supabase db push",
    "supabase:pull": "supabase db pull",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "@supabase/supabase-js": "^2.47.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "knip": "^6.15.0",
    "prettier": "^3.8.3",
    "supabase": "^2.102.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
